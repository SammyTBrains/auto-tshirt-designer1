# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security
API_KEY=your_api_key_here
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Task Queue
MAX_QUEUE_SIZE=1000
TASK_TIMEOUT=300  # seconds

# Hugging Face Token (Required)
HUGGINGFACE_TOKEN=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

# MongoDB Configuration (Required for user management, orders, etc.)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=tshirt_designer

# Stripe Payment Integration (Optional - required for checkout)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=T-Shirt Designer

# Telegram Bot (Optional - for admin notifications)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id