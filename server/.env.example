# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security
# API_KEY=your_api_key_here
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain

# Task Queue
MAX_QUEUE_SIZE=1000
TASK_TIMEOUT=300  # seconds

# Hugging Face Token (Required)
HUGGINGFACE_TOKEN=your-huggingface-token
HUGGINGFACE_MODEL=stabilityai/stable-diffusion-3.5-large
HUGGINGFACE_API_BASE=https://router.huggingface.co/hf-inference/models
HUGGINGFACE_TIMEOUT=120

# MongoDB Configuration (Required for user management, orders, etc.)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=tshirt_designer

# JWT
JWT_SECRET=change-this-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Stripe Payment Integration (Optional - required for checkout)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Your Sender Name

# Telegram Bot (Optional - for admin notifications)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Printify
PRINTIFY_API_KEY=your-printify-api-key
PRINTIFY_SHOP_ID=your-shop-id
PRINTIFY_PROVIDER_ID=provider-id
PRINTIFY_BLUEPRINT_ID=blueprint-id
PRINTIFY_DEFAULT_SHIPPING_METHOD=1
PRINTIFY_PRINT_AREA=front
